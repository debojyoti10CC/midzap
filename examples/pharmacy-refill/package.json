{
  "name": "pharmacy-refill",
  "private": true,
  "version": "0.1.0",
  "description": "BEFORE/AFTER demo: a pharmacy refill flow that uploads a prescription photo, then the same flow with a private 'credential valid + unexpired' proof via MidnightZap.",
  "type": "module",
  "scripts": {
    "sync:managed": "node ../../scripts/sync-managed.mjs",
    "predev": "npm run sync:managed",
    "prebuild": "npm run sync:managed",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnightzap/sdk": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
