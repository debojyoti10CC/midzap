// membership_proof.compact
//
// MidnightZap template: MEMBERSHIP PROOF
// ---------------------------------------
// Proves the caller holds a credential in a permissioned set (verified
// employees, licensed professionals, alumni, DAO members, ...) and issues
// a per-action nullifier so the same credential can't be replayed to act
// twice as two "different" anonymous members.
//
// This v1 checks the member commitment against an on-chain Set. That makes
// it pseudonymous, not fully anonymous: the commitment (a hash of a
// secret, never a name) is revealed, so repeat actions by the same member
// are linkable. The fully-anonymous version swaps the Set for a Merkle
// tree and proves membership with a witness path (merkleTreePathRoot) so
// nothing per-member is disclosed — see compact/NOTES.md.
//
// Typical MidnightZap usage: <ProveMembership set="verified-employees" />

pragma language_version 0.26.0;
import CompactStandardLibrary;

// Member commitments = persistentHash(["member:", secret]). The operator
// (employer / licensing board / DAO) adds one per member. A secret is
// never revealed; the commitment is a one-way hash of it.
export ledger members: Set<Bytes<32>>;

// Spent nullifiers: one credential can prove membership again for a
// different action, but cannot double-act within the same one.
export ledger spentNullifiers: Set<Bytes<32>>;

witness memberSecret(): Bytes<32>;

export circuit addMember(commitment: Bytes<32>): [] {
  members.insert(disclose(commitment));
}

// actionTag scopes the nullifier to one action (e.g. "vote:proposal-12",
// "post:thread-88").
export circuit proveMembership(actionTag: Bytes<32>): [] {
  const secret = memberSecret();
  const commitment = persistentHash<Vector<2, Bytes<32>>>([pad(32, "member:"), secret]);
  assert(members.member(disclose(commitment)), "Not a recognized member");

  const nullifier = persistentHash<Vector<3, Bytes<32>>>([pad(32, "null:"), secret, actionTag]);
  assert(!spentNullifiers.member(disclose(nullifier)), "Credential already used for this action");
  spentNullifiers.insert(disclose(nullifier));
}
