// membership_proof.compact
//
// MidnightZap template: MEMBERSHIP PROOF
// ---------------------------------------
// Proves that the caller belongs to a private, permissioned set (verified
// employees, licensed professionals, alumni, DAO members, ...) without
// revealing WHICH member they are. Uses a nullifier so the same
// credential can't be replayed to appear as two different "anonymous"
// members (e.g. to stuff a vote or post twice as "verified").
//
// Typical MidnightZap usage: <ProveMembership set="verified-employees" />,
// useMembershipProof({ set: "licensed-therapists" })
//
// NOTE: written against the Compact syntax documented at
// docs.midnight.network (language_version 0.23). Verify against your
// installed `compact` compiler before deploying.

pragma language_version 0.23;
import CompactStandardLibrary;

// Root of a Merkle tree of member commitments, set by whoever operates
// the membership list (an employer, a licensing board, a DAO). Rotating
// this root is how you add/remove members without ever publishing the
// member list itself.
export ledger merkleRoot: Bytes<32>;

// Spent nullifiers: prevents a single credential from generating more
// than one "anonymous but verified" session for the same action.
export ledger spentNullifiers: Map<Bytes<32>, Boolean>;

witness memberSecret(): Bytes<32>;
witness merkleProof(): MerkleTreePath<32, Bytes<32>>;

export circuit setMerkleRoot(newRoot: Bytes<32>): [] {
  merkleRoot = disclose(newRoot);
}

// actionTag scopes the nullifier to one action (e.g. "vote:proposal-12",
// "post:thread-88") so the same member CAN prove membership again for a
// different action, but CANNOT double-act within the same one.
export circuit proveMembership(actionTag: Bytes<32>): [] {
  secret = memberSecret();
  leaf = persistentHash<Vector<2, Bytes<32>>>([pad(32, "member:"), secret]);
  proof = merkleProof();
  assert(merkleTreePathRoot(proof, leaf) == merkleRoot, "Not a recognized member");

  nullifier = persistentHash<Vector<3, Bytes<32>>>([pad(32, "null:"), secret, actionTag]);
  assert(!spentNullifiers.member(nullifier), "Credential already used for this action");
  spentNullifiers.insert(disclose(nullifier), true);
}
