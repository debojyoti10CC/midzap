// expiry_proof.compact
//
// MidnightZap template: FRESHNESS / EXPIRY PROOF
// ------------------------------------------------
// Proves a credential (prescription, license, KYC check, insurance policy)
// is currently valid — issued by a trusted issuer and not yet expired —
// without revealing the issue date, expiry date, or credential contents.
//
// Typical MidnightZap usage: <ProveCredentialValid issuer="pharmacy-board" />
//
// NOTE: written against the Compact syntax documented at
// docs.midnight.network (language_version 0.23). Verify against your
// installed `compact` compiler before deploying.

pragma language_version 0.23;
import CompactStandardLibrary;

// Public keys of trusted issuers (a licensing board, a pharmacy network,
// a KYC provider). The app operator manages this list; MidnightZap never
// needs to see or store the credential documents themselves.
export ledger trustedIssuers: Map<Bytes<32>, Boolean>;

witness issuerPublicKey(): Bytes<32>;
witness issuerSignature(): Bytes<64>;
witness credentialHash(): Bytes<32>;
witness expiresAtUnix(): Uint<64>;

export circuit addTrustedIssuer(issuerKey: Bytes<32>): [] {
  trustedIssuers.insert(disclose(issuerKey), true);
}

// `nowUnix` is supplied by the calling app from the current block/ledger
// time, kept public since "what time is it" is not sensitive.
export circuit proveCredentialValid(nowUnix: Uint<64>): [] {
  issuer = issuerPublicKey();
  assert(trustedIssuers.member(issuer) && trustedIssuers.lookup(issuer),
    "Issuer is not trusted");

  sig = issuerSignature();
  hash = credentialHash();
  assert(verifySignature(issuer, hash, sig), "Invalid issuer signature");

  expiry = expiresAtUnix();
  assert(expiry > nowUnix, "Credential has expired");
  // Nothing about the credential's contents, issue date, or exact expiry
  // is disclosed — only the fact that a validly-signed, unexpired
  // credential was presented.
}
