// expiry_proof.compact
//
// MidnightZap template: FRESHNESS / EXPIRY PROOF
// ------------------------------------------------
// Proves a credential (prescription, licence, KYC check, insurance policy)
// is currently valid — registered by a trusted issuer and not yet expired
// — without revealing the credential's contents.
//
// v1: the issuer registers each credential as (credentialHash -> expiry)
// in an on-chain Map. The proof reveals the credentialHash (a one-way hash,
// never the document, name, prescriber, or dates) and proves its recorded
// expiry is still in the future. Fully-hidden version: keep the registry
// in a Merkle tree and prove inclusion + expiry with a witness path — see
// compact/NOTES.md.
//
// Typical MidnightZap usage: <ProveCredentialValid issuer="pharmacy-board" />

pragma language_version 0.26.0;
import CompactStandardLibrary;

// credentialHash -> expiry (unix seconds), written by the trusted issuer.
export ledger issuedCredentials: Map<Bytes<32>, Uint<64>>;

witness credentialHash(): Bytes<32>;

export circuit registerCredential(hash: Bytes<32>, expiresAtUnix: Uint<64>): [] {
  issuedCredentials.insert(disclose(hash), disclose(expiresAtUnix));
}

// `nowUnix` is supplied by the calling app from current ledger/block time;
// "what time is it" is not sensitive, so it stays public.
export circuit proveCredentialValid(nowUnix: Uint<64>): [] {
  const h = disclose(credentialHash());
  assert(issuedCredentials.member(h), "Unknown or untrusted credential");
  const expiry = issuedCredentials.lookup(h);
  assert(expiry > nowUnix, "Credential has expired");
}
