{
  "name": "@midnightzap/cli",
  "version": "0.1.0",
  "description": "Convert an existing web2 React app to a Midnight zero-knowledge privacy app — one command.",
  "keywords": ["midnight", "zero-knowledge", "codemod", "cli", "privacy", "compact"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "midnightzap": "./dist/cli.js"
  },
  "files": ["dist", "recipes", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:circuits": "node scripts/sync-circuits.mjs",
    "prepublishOnly": "npm run build && npm run sync:circuits"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  }
}
