{
  "name": "@midzap/cli",
  "version": "0.1.1",
  "description": "Convert an existing web2 React app to a Midnight zero-knowledge privacy app — one command.",
  "keywords": [
    "midnight",
    "zero-knowledge",
    "codemod",
    "cli",
    "privacy",
    "compact",
    "web3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debojyoti10CC/midzap.git",
    "directory": "packages/midnightzap-cli"
  },
  "homepage": "https://github.com/debojyoti10CC/midzap#readme",
  "bugs": "https://github.com/debojyoti10CC/midzap/issues",
  "type": "module",
  "bin": {
    "midzap": "dist/cli.js"
  },
  "files": [
    "dist",
    "recipes",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:circuits": "node scripts/sync-circuits.mjs",
    "prepublishOnly": "npm run build && npm run sync:circuits",
    "test": "node --test test/recipes.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  }
}
